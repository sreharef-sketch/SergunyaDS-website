---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import { info, links } from '../lib/config';
---

<BaseLayout title="Info — SergunyaDS" description="About SergunyaDS dolls, self-printing, and personal-use licensing.">
  <section class="panel page-panel info-page" aria-labelledby="info-title">
    <Header />
    <div class="panel-content">
      <div class="section-heading section-heading--left">
        <h1 id="info-title">{info.title}</h1>
        <p>{info.intro}</p>
      </div>
      <div class="info-grid">
        <article><h2>{info.printing_title}</h2><p>{info.printing_text}</p></article>
        <article><h2>{info.license_title}</h2><p>{info.license_text}</p></article>
        <article class="contact-card">
          <h2>Find SergunyaDS</h2>
          <a aria-label="My Patreon page" href={links.patreon} target="_blank" rel="noreferrer"><Icon size="2rem" name="patreon"/></a>
          <a aria-label="My Bluesky page" href={links.bluesky} target="_blank" rel="noreferrer"><Icon size="2rem" name="bluesky"/></a>
          <a aria-label="My Instagram page" href={links.instagram} target="_blank" rel="noreferrer"><Icon size="2rem" name="instagram"/></a>
          <a aria-label="My email" href={links.email}><Icon size="2rem" name="envelope"/></a>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
