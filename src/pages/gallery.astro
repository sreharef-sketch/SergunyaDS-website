---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import GalleryModal from '../components/GalleryModal.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
---

<BaseLayout title="Gallery — SergunyaDS" description="Renders, print tests, and work in progress from SergunyaDS.">
  <section class="panel page-panel gallery-page" aria-labelledby="gallery-title">
    <Header />
    <div class="panel-content">
      <GalleryGrid />
    </div>
  </section>
  <GalleryModal />
</BaseLayout>
